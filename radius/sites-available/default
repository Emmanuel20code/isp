# -*- text -*-
##
## default site configuration for EMMATECH PPPoE & Hotspot
##

server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}

	authorize {
		preprocess
		chap
		mschap
		digest
		sql
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
		Auth-Type MS-CHAP {
			mschap
		}
	}

	preacct {
		preprocess
		acct_unique
	}

	accounting {
		detail
		sql
	}

	session {
		sql
	}

	post-auth {
		sql
		Post-Auth-Type REJECT {
			sql
			attr_filter.access_reject
		}
	}
}
