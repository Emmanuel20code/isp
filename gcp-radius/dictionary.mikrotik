# MikroTik Vendor specific attributes
VENDOR          MikroTik        14988

BEGIN-VENDOR   MikroTik

ATTRIBUTE       Mikrotik-Recv-Limit             1       integer
ATTRIBUTE       Mikrotik-Xmit-Limit             2       integer
ATTRIBUTE       Mikrotik-Group                  3       string
ATTRIBUTE       Mikrotik-Wireless-Forward       4       integer
ATTRIBUTE       Mikrotik-Wireless-Skip-Dot1x    5       integer
ATTRIBUTE       Mikrotik-Wireless-Enc-Key       6       string
ATTRIBUTE       Mikrotik-Rate-Limit             7       string
ATTRIBUTE       Mikrotik-Advertise-URL          8       string
ATTRIBUTE       Mikrotik-Advertise-Interval     9       integer
ATTRIBUTE       Mikrotik-Dhcp-Pool              10      string

END-VENDOR      MikroTik
